<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TermuxMod APK Builder"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Engine Kotlin native — pengganti build.sh"
            android:textSize="13sp"
            android:alpha="0.7"
            android:paddingBottom="16dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/builder_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IDLE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/builder_message_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menunggu perintah build..."
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <ProgressBar
            android:id="@+id/builder_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:paddingBottom="16dp" />

        <!-- Project & Mode -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Project (dari /sdcard)"
            android:textSize="13sp"
            android:alpha="0.8"
            android:paddingTop="8dp" />

        <Spinner
            android:id="@+id/builder_project_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mode build"
            android:textSize="13sp"
            android:alpha="0.8"
            android:paddingTop="8dp" />

        <Spinner
            android:id="@+id/builder_mode_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <!-- Tombol -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/builder_start_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start Build"
                android:textStyle="bold" />

            <Button
                android:id="@+id/builder_cancel_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:enabled="false"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Log -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log"
            android:textSize="13sp"
            android:alpha="0.8"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/builder_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:text="—"
            android:textSize="12sp"
            android:typeface="monospace"
            android:background="#F0F0F0"
            android:padding="8dp" />

    </LinearLayout>

</ScrollView>
