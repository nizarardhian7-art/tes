<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/builder_bg">

    <!-- ===================== Project Card ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:layout_marginBottom="4dp"
        style="@style/Widget.Builder.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/builder_project_label"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:textColor="@color/builder_on_surface_muted"
                android:letterSpacing="0.08" />

            <Spinner
                android:id="@+id/builder_project_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/builder_mode_label"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:textColor="@color/builder_on_surface_muted"
                android:letterSpacing="0.08" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/builder_mode_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/builder_mode_debug"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/builder_mode_debug" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/builder_mode_release"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/builder_mode_release" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/builder_mode_clean"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/builder_mode_clean" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== Status Card ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        style="@style/Widget.Builder.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/builder_status_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/builder_status_idle"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/builder_status_running" />

                <TextView
                    android:id="@+id/builder_elapsed_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0s"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/builder_on_surface_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/builder_message_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/builder_message_idle"
                android:textSize="13sp"
                android:textColor="@color/builder_on_surface_muted" />

            <ProgressBar
                android:id="@+id/builder_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== Log Panel (terminal-like) ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp"
        android:layout_marginTop="4dp"
        style="@style/Widget.Builder.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/builder_log_label"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:textColor="@color/builder_on_surface_muted"
                    android:letterSpacing="0.08" />

                <ImageButton
                    android:id="@+id/builder_log_clear"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_clear_log"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/builder_log_clear" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/builder_log_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/builder_log_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:fontFamily="monospace"
                    android:textColor="@color/builder_log_text"
                    android:background="@color/builder_log_bg"
                    android:padding="10dp"
                    android:lineSpacingExtra="2dp"
                    android:textIsSelectable="true" />
            </ScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== Action Bar ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/builder_import_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/builder_import_backup"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/builder_export_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/builder_export_backup"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/builder_cancel_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:enabled="false"
            android:text="@string/builder_cancel"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/builder_start_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/builder_start"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
